{
  "name": "reddog-toolkit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local runtime-test toolkit for Cocos Creator slot games: a service, an MCP server and a dashboard that record evidence and check it, built to spend few tokens.",
  "engines": {
    "node": ">=22.16"
  },
  "bin": {
    "gameplay-test": "dist/adapters/cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --test test/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "catalog": "node scripts/gen-catalog.mjs",
    "mcp": "node dist/adapters/mcp.js",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^24.43.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.6.0",
    "ws": "^8.23.0"
  }
}
